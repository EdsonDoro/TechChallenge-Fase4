# LLM local gratuito via Ollama
LLM_PROVIDER=ollama
LLM_MODEL=llama3.2
OLLAMA_BASE_URL=http://localhost:11434/v1

# Opcional: somente se quiser usar OpenAI em vez do Ollama
OPENAI_API_KEY=

# Embeddings locais
EMBEDDING_PROVIDER=sentence-transformers
EMBEDDING_MODEL=sentence-transformers/paraphrase-multilingual-MiniLM-L12-v2

# RAG
TOP_K=5
MIN_RELEVANCE_SCORE=0.25\nMIN_SCOPE_SCORE=0.55
MIN_DOMAIN_SCORE=0.45

# Dados
DATA_DIR=data
